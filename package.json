{
  "name": "saskaitago",
  "version": "0.3.2",
  "private": true,
  "description": "Local-first Lithuanian invoicing for small businesses",
  "desktopName": "saskaitago",
  "author": "CloudCore",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "serve": "node server.mjs",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:windows": "electron-builder --win nsis --publish never",
    "dist:windows:docker": "bash scripts/dist-windows-docker.sh",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:local": "pnpm run dist:linux && pnpm run dist:windows:docker",
    "fetch:mac": "bash scripts/fetch-mac-build.sh",
    "publish:downloads": "bash scripts/publish-downloads.sh",
    "test": "node --test",
    "check": "node --check server.mjs && node --check electron/main.mjs && node --check electron/updater.mjs && node --check public/app.js && node --check public/i18n.js && node --check public/invoice.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "3.3.3"
  },
  "build": {
    "appId": "lt.saskaitago.desktop",
    "productName": "SaskaitaGO",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "server.mjs",
      "package.json",
      "README.md"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "info@cloudcore.lt",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SaskaitaGO-Setup.exe"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "appImage": {
      "artifactName": "SaskaitaGO.AppImage"
    },
    "deb": {
      "artifactName": "SaskaitaGO.deb"
    },
    "dmg": {
      "artifactName": "SaskaitaGO.dmg"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://saskaitago.lt/downloads/"
      }
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "repository": "github:cloudcore-app/saskaitago",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
