{
  "name": "saskaitago",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first Lithuanian invoicing for small businesses",
  "desktopName": "saskaitago",
  "author": "CloudCore",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "electron .",
    "dev:site": "node scripts/serve-website.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "electron .",
    "serve": "node server.mjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:windows": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "lt.saskaitago.desktop",
    "productName": "SaskaitaGO",
    "asar": true,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**", "public/**", "server.mjs", "package.json", "README.md"],
    "linux": { "icon": "build/icon.png", "category": "Office", "maintainer": "info@cloudcore.lt", "syncDesktopName": true, "target": ["AppImage", "deb"] },
    "win": { "icon": "build/icon.ico", "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "icon": "build/icon.icns", "target": ["dmg"], "category": "public.app-category.business" }
  },
  "engines": { "node": ">=22" }
}
